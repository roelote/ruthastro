<style>
  /* Botón flotante de WhatsApp */
  .whatsapp-float {
    position: fixed;
    bottom: 25px;
    right: 25px;
    background-color: #25D366;
    color: white;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
    transition: all 0.3s ease;
    z-index: 1000;
    cursor: pointer;
  }

  .whatsapp-float:hover {
    background-color: #128C7E;
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.6);
  }

  .whatsapp-float svg {
    width: 32px;
    height: 32px;
  }

  @media (max-width: 768px) {
    .whatsapp-float {
      bottom: 20px;
      right: 20px;
      width: 56px;
      height: 56px;
    }

    .whatsapp-float svg {
      width: 28px;
      height: 28px;
    }
  }
</style>