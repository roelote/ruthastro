---
import '../styles/global.css';
import '@fancyapps/ui/dist/fancybox/fancybox.css';
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';
import 'swiper/css/autoplay';
import 'swiper/css/effect-fade';
import type { YoastSEO } from '../utils/wordpress';

interface Props {
	title?: string;
	description?: string;
	yoastSEO?: YoastSEO | null;
	favicon?: string;
	canonical?: string;
	lang?: string;
	hreflangLinks?: Array<{ lang: string; url: string }>;
}

const { 
	title = 'Ruth Amazon Expeditions', 
	description = 'Explora la selva amazónica con los mejores guías',
	yoastSEO = null,
	favicon = '/favicon.svg',
	canonical,
	lang = 'es',
	hreflangLinks,
} = Astro.props;

// ── hreflang (multiidioma) ──
const siteUrl = (Astro.site?.toString() || '').replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const computedHreflang = hreflangLinks ?? (() => {
	const esPath = lang === 'en' ? (currentPath.replace(/^\/en/, '') || '/') : currentPath;
	const enPath = lang === 'en' ? currentPath : '/en' + currentPath;
	return [
		{ lang: 'es', url: `${siteUrl}${esPath}` },
		{ lang: 'en', url: `${siteUrl}${enPath}` },
		{ lang: 'x-default', url: `${siteUrl}${esPath}` },
	];
})();

// Usar datos de Yoast SEO si están disponibles
const pageTitle = yoastSEO?.title || title;
const pageDescription = yoastSEO?.description || description;
const pageCanonical = yoastSEO?.canonical || canonical || Astro.url.href;
const ogTitle = yoastSEO?.og_title || pageTitle;
const ogDescription = yoastSEO?.og_description || pageDescription;
const ogImageFallback = `${(Astro.site?.toString() || '').replace(/\/$/, '')}/og-image.jpg`;
const ogImage = yoastSEO?.og_image || ogImageFallback;
const ogType = yoastSEO?.og_type || 'website';
const ogUrl = yoastSEO?.og_url || Astro.url.href;
const twitterCard = yoastSEO?.twitter_card || 'summary_large_image';
const twitterTitle = yoastSEO?.twitter_title || ogTitle;
const twitterDescription = yoastSEO?.twitter_description || ogDescription;
const twitterImage = yoastSEO?.twitter_image || ogImage;
// El backend WordPress puede tener noindex activado (es headless/privado).
// El frontend Astro siempre debe ser indexable por buscadores.
const robotsIndex = 'index';
const robotsFollow = 'follow';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- Favicon -->
		<link rel="icon" type="image/x-icon" href={favicon} />
		<link rel="shortcut icon" type="image/x-icon" href={favicon} />
		
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="robots" content={`${robotsIndex}, ${robotsFollow}`} />
		<link rel="canonical" href={pageCanonical} />
		
		<!-- hreflang multiidioma -->
		{computedHreflang.map(h => (
			<link rel="alternate" hreflang={h.lang} href={h.url} />
		))}
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
		<meta property="og:site_name" content="Ruth Amazon Expeditions" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:url" content={ogUrl} />
		<meta name="twitter:title" content={twitterTitle} />
		<meta name="twitter:description" content={twitterDescription} />
		<meta name="twitter:image" content={twitterImage || ogImage} />
	</head>

	<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-Q7ZMPRW52B"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-Q7ZMPRW52B');
</script>


	<body class="antialiased">
		<slot />
	</body>
</html>


