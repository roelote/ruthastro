          </svg>
          @ruthamazonexpeditions
        </a>
      </div>

      <!-- Grilla Instagram -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-1.5 md:gap-2">
        {posts.map((post) => {
          const imgSrc = post.media_type === 'VIDEO'
            ? (post.thumbnail_url ?? post.media_url)
            : post.media_url;
          const caption = post.caption?.replace(/#\S+/g, '').trim().slice(0, 80) || 'Ruth Amazon Expeditions';

          return (
            <a
              href={post.permalink}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative aspect-square overflow-hidden bg-gray-100"
            >
              <img
                src={imgSrc}
                alt={caption}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <!-- Overlay al hover -->
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/50 transition-all duration-300 flex items-center justify-center">
                <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-center px-3">
                  {post.media_type === 'VIDEO' && (
                    <svg class="w-8 h-8 text-white mx-auto mb-2" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  )}
                  {post.media_type === 'CAROUSEL_ALBUM' && (
                    <svg class="w-6 h-6 text-white mx-auto mb-2" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M2 5h14v14H2V5zm16-2v18H4v-2h12V3h2zM20 1v18H6v-2h12V1h2z"/>
                    </svg>
                  )}
                  <p class="text-white text-xs leading-snug line-clamp-3">{caption}</p>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Botón ver más -->
      <div class="text-center mt-8 md:mt-10">
        <a
          href="https://www.instagram.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-linear-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] text-white font-semibold px-6 md:px-8 py-3 rounded-full hover:opacity-90 transition-opacity shadow-lg text-sm md:text-base"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Ver más en Instagram
        </a>
      </div>

    </div>
  </section>
)}
