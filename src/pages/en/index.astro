                  <div class="flex gap-1">
                    {Array.from({ length: 5 }).map((_, i) => (
                      <svg class={`w-4 h-4 ${i < testimonial.rating ? 'text-[#00aa6c]' : 'text-gray-300'}`} fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    ))}
                  </div>
                  <img src={tripadvisorLogo.src} alt="TripAdvisor" loading="lazy" width={tripadvisorLogo.width} height={tripadvisorLogo.height} class="h-6 w-auto opacity-80" />
                </div>
                {testimonial.title && (
                  <h4 class="font-semibold text-gray-900 text-sm mb-2 line-clamp-1">{testimonial.title}</h4>
                )}
                <p class="text-gray-600 text-sm leading-relaxed mb-5 grow line-clamp-5">
                  "{testimonial.comment}"
