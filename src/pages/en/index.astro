---
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import Header from '../../layouts/Header.astro';
import Footer from '../../layouts/Footer.astro';
import { getPosts, getFeaturedImage, getYoastSEO, getSiteInfo } from '../../utils/wordpress';
import { getTripAdvisorReviews } from '../../utils/testimonials';

// Local images
import pacayaPortada from '../../assets/pacaya-samiria-portada.webp';
import tourFallback from '../../assets/tour-fallback.jpg';
import delfinesRosados from '../../assets/delfines-rosados-ruth.webp';
import pacayaBoat from '../../assets/pacaya-samiria-boat.webp';
import pacaya31 from '../../assets/pacaya3-1.jpg';
import pacaya32 from '../../assets/pacaya3-2.jpg';
import tripadvisorLogo from '../../assets/tripadvisor_image.png';
import equipoRuth2 from '../../assets/equiporuth2.webp';
import equipoRuth4 from '../../assets/equiporuth4.webp';
import equipo2 from '../../assets/equipo2.png';
import equipo3 from '../../assets/equipo3.png';
import selvaAutentica1 from '../../assets/selva-autentica-1.jpeg';
import selvaAutentica2 from '../../assets/selva-autentica-2.jpeg';
import selvaAutentica3 from '../../assets/selva-autentica-3.jpeg';
import pacayaSamiria41 from '../../assets/pacaya-samiria41.webp';
import pacayaSamiria42 from '../../assets/pacaya-samiria42.jpeg';
import pacayaSarmiria5d from '../../assets/pacaya-sarmiria5d.jpeg';
import pacayaSarmiria43 from '../../assets/pacaya-sarmiria43.jpeg';
import pacayaSamiriaSelvaVirgen1 from '../../assets/pacaya-samiria-selva-virgen-1.jpeg';
import pacayaSamiriaSelvaVirgen3 from '../../assets/pacaya-samiria-selva-virgen-3.jpeg';
import pacayaSamiriaSelvaVirgen4 from '../../assets/pacaya-samiria-selva-virgen-4.jpeg';
import pacayaSamiriaSelvaVirgen5 from '../../assets/pacaya-samiria-selva-virgen-5.jpeg';
import imgTransporte from '../../assets/transporte.jpeg';
import imgComida from '../../assets/comida.jpeg';
import imgCabanias from '../../assets/cabanias.jpeg';

// Get tours in English from WordPress (WPML ?lang=en)
const tours = await getPosts('en');

const excludedSlugs = [
  'mystical-pacaya-samiria-3-days-tour',
  'pacaya-samiria-authentic-jungle-4-days-tour',
  'pacaya-samiria-5-days-tour',
  'pacaya-samiria-10-days-tour'
];

const filteredTours = tours.filter(tour => !excludedSlugs.includes(tour.slug));
const featuredTours = filteredTours.slice(0, 9);

const pacaya3dias = tours.find(tour => tour.slug === 'mystical-pacaya-samiria-3-days-tour');
const pacaya4dias = tours.find(tour => tour.slug === 'pacaya-samiria-authentic-jungle-4-days-tour');
const pacaya5dias = tours.find(tour => tour.slug === 'pacaya-samiria-5-days-tour');
const pacaya10dias = tours.find(tour => tour.slug === 'pacaya-samiria-10-days-tour');

const procesarPrecio = (precio: any) => {
  if (!precio) return { monto: 'Contact us', porPersona: null };
  const partes = precio.split(/\s+(per\s+person|por\s+persona)/i);
  return { monto: partes[0], porPersona: partes[1] };
};

const precio3dias  = procesarPrecio(pacaya3dias?.acf?.precio);
const precio4dias  = procesarPrecio(pacaya4dias?.acf?.precio);
const precio5dias  = procesarPrecio(pacaya5dias?.acf?.precio);
const precio10dias = procesarPrecio(pacaya10dias?.acf?.precio);

const toursWithImages = await Promise.all(
  featuredTours.map(async (tour) => {
    const imageUrl = tour.featured_media
      ? await getFeaturedImage(tour.featured_media)
      : tourFallback.src;
    return { ...tour, imageUrl };
  })
);

const testimonials = await getTripAdvisorReviews(1);

const yoastSEO = await getYoastSEO('home', 'pages');
const siteInfo = await getSiteInfo();
const favicon = siteInfo?.icon?.favicon || '/favicon.svg';
---

<Layout
  title="Ruth Amazon Expeditions - Pacaya Samiria Tours"
  description="Discover the Pacaya Samiria National Reserve with the best guided tours. 3, 4, 5 and 10 day expeditions in the Peruvian Amazon jungle."
  yoastSEO={yoastSEO}
  favicon={favicon}
  lang="en"
>
  <Header lang="en" />

  <!-- Hero Section with Swiper Carousel -->
  <section class="hero-section relative">
    <div class="swiper hero-swiper">
      <div class="swiper-wrapper">
        <!-- Slide 1 -->
        <div class="swiper-slide">
          <div class="relative h-[500px] md:h-[600px] lg:h-[800px] overflow-hidden">
            <img
              src={pacayaPortada.src}
              alt="Pacaya Samiria"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
              width={pacayaPortada.width}
              height={pacayaPortada.height}
            />
            <div class="absolute inset-0 bg-black/40"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="container text-center text-white px-4">
                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4 md:mb-6 animate-fade-in">
                  Discover Pacaya Samiria 2026
                </h1>
                <p class="text-base sm:text-lg md:text-xl lg:text-2xl mb-6 md:mb-8 max-w-3xl mx-auto px-4">
                  Experience the most authentic Amazon adventure in the largest natural reserve of Peru
                </p>
                <a
                  href="#tours"
                  class="inline-block bg-[#15803d] hover:bg-[#166534] text-white font-bold px-6 md:px-8 py-3 md:py-4 rounded-lg text-base md:text-lg transition-all duration-300 transform hover:scale-105 shadow-xl"
                >
                  Explore Our Tours
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="swiper-slide">
          <div class="relative h-[500px] md:h-[600px] lg:h-[800px] overflow-hidden">
            <img
              src={delfinesRosados.src}
              alt="Amazon Jungle"
              class="w-full h-full object-cover"
              loading="lazy"
              width={delfinesRosados.width}
              height={delfinesRosados.height}
            />
            <div class="absolute inset-0 bg-black/40"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="container text-center text-white px-4">
                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4 md:mb-6">
                  Unforgettable Adventures
                </h1>
                <p class="text-base sm:text-lg md:text-xl lg:text-2xl mb-6 md:mb-8 max-w-3xl mx-auto px-4">
                  Explore the unique biodiversity of the Peruvian Amazon with expert guides
                </p>
                <a
                  href="#tours"
                  class="inline-block bg-[#15803d] hover:bg-[#166534] text-white font-bold px-6 md:px-8 py-3 md:py-4 rounded-lg text-base md:text-lg transition-all duration-300 transform hover:scale-105 shadow-xl"
                >
                  View Available Tours
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 3 -->
        <div class="swiper-slide">
          <div class="relative h-[500px] md:h-[600px] lg:h-[800px] overflow-hidden">
            <img
              src={pacayaBoat.src}
              alt="Amazon River"
              class="w-full h-full object-cover"
              loading="lazy"
              width={pacayaBoat.width}
              height={pacayaBoat.height}
            />
            <div class="absolute inset-0 bg-black/40"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="container text-center text-white px-4">
                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4 md:mb-6">
                  Pacaya Samiria Natural Reserve
                </h1>
                <p class="text-base sm:text-lg md:text-xl lg:text-2xl mb-6 md:mb-8 max-w-3xl mx-auto px-4">
                  Navigate the most spectacular rivers and discover the Amazonian wildlife
                </p>
                <a
                  href="#tours"
                  class="inline-block bg-[#15803d] hover:bg-[#166534] text-white font-bold px-6 md:px-8 py-3 md:py-4 rounded-lg text-base md:text-lg transition-all duration-300 transform hover:scale-105 shadow-xl"
                >
                  Book Now
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="hero-button-next">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </div>
      <div class="hero-button-prev">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </div>
      <div class="hero-pagination"></div>
    </div>
  </section>

  <!-- About Us Section -->
  <section class="py-12 md:py-16 lg:py-20 bg-gray-50">
    <div class="container px-4">
      <div class="grid lg:grid-cols-2 gap-8 md:gap-10 lg:gap-12 items-center">
        <!-- Text Content -->
        <div class="space-y-4 md:space-y-6">
          <div class="inline-block">
            <span class="text-[#15803d] font-semibold text-xs md:text-sm tracking-wider uppercase">About Us</span>
            <div class="h-0.5 w-16 bg-yellow-400 mt-2"></div>
          </div>

          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900">
            Amazon Expedition
            <span class="text-[#15803d]"> Specialists</span>
          </h2>

          <p class="text-base md:text-lg text-gray-700 leading-relaxed">
            <strong class="text-[#15803d]">Ruth Amazon Expeditions</strong> is an agency specialized in tours to the Pacaya Samiria National Reserve, recognized as one of the most important protected areas in the Peruvian Amazon. We are proud to be known nationally and internationally through the satisfaction of our clients.
          </p>

          <p class="text-base md:text-lg text-gray-700 leading-relaxed">
            Our professional native guides will take you to explore the most remote corners of the jungle, where you can observe pink dolphins, anacondas, jaguars, macaws, and hundreds of species in their natural habitat.
          </p>

          <!-- Stats -->
          <div class="grid grid-cols-3 gap-3 md:gap-4 pt-4 md:pt-6">
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-[#15803d]">15+</div>
              <div class="text-gray-600 text-xs md:text-sm mt-1 md:mt-2">Years of Experience</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-[#15803d]">100%</div>
              <div class="text-gray-600 text-xs md:text-sm mt-1 md:mt-2">Sustainable Tourism</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-yellow-500">⭐</div>
              <div class="text-gray-600 text-xs md:text-sm mt-1 md:mt-2">Best Rated</div>
            </div>
          </div>

          <!-- Buttons -->
          <div class="flex flex-col sm:flex-row gap-3 md:gap-4 pt-4">
            <a
              href="/en/about-us"
              class="inline-flex items-center justify-center gap-2 bg-[#15803d] hover:bg-[#166534] text-white font-semibold px-5 md:px-6 py-2.5 md:py-3 rounded-lg transition-all duration-300 text-sm md:text-base"
            >
              Learn More
            </a>
            <a
              href="https://wa.me/51965001929"
              class="inline-flex items-center justify-center gap-2 border-2 bg-yellow-400 border-yellow-400 text-gray-900 font-semibold px-5 md:px-6 py-2.5 md:py-3 rounded-lg hover:bg-yellow-500 transition-all duration-300 text-sm md:text-base"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Contact Us
            </a>
          </div>
        </div>

        <!-- Image Gallery -->
        <div class="grid grid-cols-2 gap-3 md:gap-4 mt-8 lg:mt-0">
          <img src={equipoRuth2.src} alt="Local guide" class="w-full h-48 md:h-56 lg:h-64 object-cover rounded-lg shadow-md" loading="lazy" width="800" height="600" />
          <img src={equipoRuth4.src} alt="Tourists in the jungle" class="w-full h-48 md:h-56 lg:h-64 object-cover rounded-lg shadow-md mt-4 md:mt-6 lg:mt-8" loading="lazy" width="800" height="600" />
          <img src={equipo2.src} alt="Pink dolphin" class="w-full h-48 md:h-56 lg:h-64 object-cover rounded-lg shadow-md -mt-4 md:-mt-6 lg:-mt-8" loading="lazy" width="800" height="600" />
          <img src={equipo3.src} alt="Sunset on the river" class="w-full h-48 md:h-56 lg:h-64 object-cover rounded-lg shadow-md" loading="lazy" width="800" height="600" />
        </div>
      </div>
    </div>
  </section>

  <!-- Main Pacaya Samiria Tours Section -->
  <section class="py-12 md:py-16 lg:py-20 bg-linear-to-br from-[#15803d] via-green-700 to-[#166534] relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 left-0 w-96 h-96 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-yellow-400 rounded-full blur-3xl"></div>
    </div>

    <div class="container px-4 relative z-10">
      <div class="text-center mb-10 md:mb-14">
        <div class="inline-block mb-4">
          <span class="text-yellow-400 font-semibold text-xs md:text-sm tracking-wider uppercase">Our Main Tours</span>
          <div class="h-0.5 w-16 bg-yellow-400 mt-2 mx-auto"></div>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
          Main <span class="text-yellow-400">Pacaya Samiria Tours</span>
        </h2>
        <p class="text-base md:text-lg text-white/90 max-w-3xl mx-auto px-4">
          Discover our most complete tours to explore the largest reserve in Peru
        </p>
      </div>

      <!-- 2x2 Tour Grid -->
      <div class="grid md:grid-cols-2 gap-8 md:gap-10 mx-auto">
        <!-- 3-Day Tour -->
        <article class="group relative bg-white rounded-2xl overflow-hidden shadow-2xl hover:shadow-3xl transition-all duration-500 transform hover:-translate-y-2 flex flex-col md:flex-row md:h-[450px]">
          <div class="relative md:w-1/2 h-64 md:h-auto overflow-hidden shrink-0">
            <div class="swiper tour-3days-swiper h-full">
              <div class="swiper-wrapper">
                <div class="swiper-slide">
                  <img src={pacaya31.src} alt="Pacaya Samiria - Aerial View" class="w-full h-full object-cover" loading="lazy" width={pacaya31.width} height={pacaya31.height} />
                </div>
                <div class="swiper-slide">
                  <video src="/video/pacaya3dias.mp4" class="w-full h-full object-cover" autoplay loop muted playsinline preload="none"></video>
                </div>
                <div class="swiper-slide">
                  <img src={pacaya32.src} alt="Jungle Camping" class="w-full h-full object-cover" loading="lazy" width={pacaya32.width} height={pacaya32.height} />
                </div>
                <div class="swiper-slide">
                  <video src="/video/pacaya3dias1.mp4" class="w-full h-full object-cover" autoplay loop muted playsinline preload="none"></video>
                </div>
              </div>
            </div>
            <div class="swiper-pagination-3days mt-2"></div>
          </div>
          <div class="p-4 md:p-6 flex flex-col justify-between md:w-1/2">
            <div class="mb-3">
              <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Pacaya Samiria 3 Days</h3>
              <p class="text-gray-600 text-sm md:text-base mb-3">Express Adventure in the Amazon Jungle</p>
              <div class="inline-flex items-baseline gap-2 bg-green-50 px-4 py-2 rounded-lg">
                <span class="text-3xl font-bold text-[#15803d]">{precio3dias.monto}</span>
                {precio3dias.porPersona && <span class="text-xs text-gray-500 ml-1">{precio3dias.porPersona}</span>}
              </div>
            </div>
            <div class="space-y-3">
              <div class="grid grid-cols-3 gap-3 py-3 border-y border-gray-200">
                <div class="text-center"><div class="text-2xl font-bold text-[#15803d]">3</div><div class="text-xs text-gray-600">Days</div></div>
                <div class="text-center"><div class="text-2xl font-bold text-[#15803d]">2</div><div class="text-xs text-gray-600">Nights</div></div>
                <div class="text-center"><div class="text-2xl font-bold text-[#15803d]">2-12</div><div class="text-xs text-gray-600">People</div></div>
              </div>
              <ul class="space-y-2">
                <li class="flex items-center gap-3"><svg class="w-5 h-5 text-[#15803d] shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg><span class="text-gray-700">Pink dolphins</span></li>
                <li class="flex items-center gap-3"><svg class="w-5 h-5 text-[#15803d] shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg><span class="text-gray-700">Camping</span></li>
                <li class="flex items-center gap-3"><svg class="w-5 h-5 text-[#15803d] shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg><span class="text-gray-700">Expert guide</span></li>
              </ul>
            </div>
            <div class="flex gap-2 mt-4">
              <a href="/en/pacaya-samiria-mistico-3-dias-2-noches/" class="flex-1 text-center bg-[#15803d] hover:bg-[#166534] text-white font-semibold px-4 py-2 rounded-lg transition-all text-sm">See Details</a>
              <a href="https://wa.me/51965001929?text=Tour%20Pacaya%20Samiria%203%20days" class="flex items-center justify-center bg-green-500 hover:bg-green-600 text-white font-semibold px-4 py-2 rounded-lg transition-all" title="Ask on WhatsApp">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              </a>
            </div>
          </div>
        </article>

        <!-- 4-Day Tour -->
        <article class="group relative bg-white rounded-2xl overflow-hidden shadow-2xl hover:shadow-3xl transition-all duration-500 transform hover:-translate-y-2 flex flex-col md:flex-row md:h-[450px]">
          <div class="relative md:w-1/2 h-64 md:h-auto overflow-hidden shrink-0">
            <div class="swiper tour-4days-swiper h-full">
              <div class="swiper-wrapper">
                <div class="swiper-slide"><img src={selvaAutentica3.src} alt="Amazon Jungle" class="w-full h-full object-cover" loading="lazy" width="800" height="600" /></div>
                <div class="swiper-slide"><img src={selvaAutentica2.src} alt="River Sunset" class="w-full h-full object-cover" loading="lazy" width="800" height="600" /></div>
                <div class="swiper-slide"><img src={selvaAutentica1.src} alt="Amazon Wildlife" class="w-full h-full object-cover" loading="lazy" width="800" height="600" /></div>
              </div>
            </div>
